# Copy to .env and fill in.
DATABASE_URL="postgresql://USER@localhost:5432/dlrs_os?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

STORAGE_DIR="./.storage"

# --- AI & Extraction Engine (PRD §30) ---------------------------------------
# Active provider: "anthropic" | "openai" | "gemini" | "heuristic" (default: auto-detect)
AI_PROVIDER=""

# Anthropic Claude
ANTHROPIC_API_KEY=""
AGENT_MODEL="claude-3-5-sonnet-20241022"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# --- Secrets Vault (PRD §44) ------------------------------------------------
# 32 bytes, hex-encoded. Encrypts OAuth token blobs at rest in the database.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_ENCRYPTION_KEY=""

# --- Google Workspace Integrations (PRD §45) --------------------------------
# Registered in Google Cloud Console with redirects to:
# - <origin>/api/integrations/gmail/callback
# - <origin>/api/integrations/drive/callback
# - <origin>/api/integrations/calendar/callback
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# --- Ingestion Webhooks (PRD §6) --------------------------------------------
WEBHOOK_SECRET="dlrs-inbox-webhook-secret"

