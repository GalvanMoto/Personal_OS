      "icons": [{ "src": "/favicon.ico", "sizes": "96x96" }]
    },
    {
      "name": "Quick Capture",
      "short_name": "Capture",
      "description": "Capture anything to your Universal Inbox",
      "url": "/dashboard",
      "icons": [{ "src": "/favicon.ico", "sizes": "96x96" }]
    },
    {
      "name": "Ask Assistant",
      "short_name": "Assistant",
      "description": "Talk to your AI Chief-of-Staff",
      "url": "/dashboard",
      "icons": [{ "src": "/favicon.ico", "sizes": "96x96" }]
    },
    {
      "name": "Today",
      "short_name": "Today",
      "description": "Your daily briefing and next best action",
      "url": "/dashboard",
      "icons": [{ "src": "/favicon.ico", "sizes": "96x96" }]
    },
    {
      "name": "Inbox",
      "short_name": "Inbox",
      "description": "Review captured items awaiting processing",
      "url": "/dashboard",
      "icons": [{ "src": "/favicon.ico", "sizes": "96x96" }]
