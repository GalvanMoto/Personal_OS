{
  "name": "DLRS Personal OS",
  "short_name": "DLRS OS",
  "description": "Your AI Chief-of-Staff and Personal Operating System — capture, organize, and act.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay"],
  "orientation": "portrait-primary",
  "background_color": "#09090b",
